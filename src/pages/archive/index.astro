---
import Base from '../../layouts/Base.astro'; import {archive} from '../../lib/content'; import {russianDate} from '../../lib/date';
const list=archive(); const groups=Map.groupBy(list,q=>new Intl.DateTimeFormat('ru-RU',{month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(q.publishDate+'T12:00:00Z')));
---
<Base title="Архив — Вопрос на вечер"><h1>Архив</h1><p>Предыдущие вопросы — без спойлеров.</p><div id="archive">{[...groups].map(([month,qs],gi)=><section class="archive-group" data-page={Math.floor(gi/12)}><h2>{month}</h2><ul class="archive-list">{qs.map(q=><li><a href={`/archive/${q.publishDate}/`} data-id={q.id}><span>{russianDate(q.publishDate)}</span><span class="status" hidden>Ответ открыт</span></a></li>)}</ul></section>)}</div>{list.length>30&&<button id="more">Показать ещё</button>}<script is:inline>for(const a of document.querySelectorAll('[data-id]')){try{const p=JSON.parse(localStorage.getItem('vecher:'+a.dataset.id)||'null');if(p?.answerRevealed)a.querySelector('.status').hidden=false}catch{}}const groups=[...document.querySelectorAll('.archive-group')];groups.forEach((x,i)=>x.hidden=i>=30);const more=document.querySelector('#more');more?.addEventListener('click',()=>{groups.forEach(x=>x.hidden=false);more.remove()});addEventListener('pagehide',()=>sessionStorage.setItem('archive-scroll',String(scrollY)));const y=sessionStorage.getItem('archive-scroll');if(y)requestAnimationFrame(()=>scrollTo(0,+y));</script></Base>
